# Shared settings for every script in aosp/scripts. Override any of these by
# exporting the variable before running a script, e.g.
#   AOSP_BRANCH=android-16.0.0_r2 ./scripts/10-sync-aosp.sh

# Where the big checkouts live. AOSP needs ~400 GB free after a build,
# the kernel checkout ~40 GB. Put these on a fast SSD.
: "${WORK_ROOT:=$HOME/holy-os}"
: "${AOSP_DIR:=$WORK_ROOT/aosp}"
: "${KERNEL_DIR:=$WORK_ROOT/kernel}"
: "${APPS_DIR:=$WORK_ROOT/apps}"

# Platform source. android-latest-release tracks the newest public AOSP
# release; pin a tag (e.g. android-16.0.0_r2) for reproducible builds.
: "${AOSP_MANIFEST_URL:=https://android.googlesource.com/platform/manifest}"
: "${AOSP_BRANCH:=android-latest-release}"

# Android Common Kernel (GKI). Pick the branch that matches the AOSP
# release: Android 16 ships with android16-6.12.
: "${KERNEL_MANIFEST_URL:=https://android.googlesource.com/kernel/manifest}"
: "${KERNEL_BRANCH:=common-android16-6.12}"

# Base product to build on. Two x86_64 emulator choices:
#   sdk_phone64_x86_64      the classic Android Emulator (window on your desktop)
#   aosp_cf_x86_64_phone    Cuttlefish (headless, viewed in a browser, needs
#                           the cuttlefish host packages, see README)
: "${BASE_PRODUCT:=sdk_phone64_x86_64}"
# Release config + variant appended to the lunch target.
: "${RELEASE:=trunk_staging}"
: "${VARIANT:=userdebug}"

# Parallelism for repo sync and the build. Defaults to all cores.
: "${JOBS:=$(nproc)}"

# The Holy apps baked into the image: "<github repo> <module name>" per line.
# Dirty7 is left out because Dirty7J uses the same applicationId.
: "${HOLY_APPS:=TheMasihZn/AiNoteAndroid HolyAiNote
TheMasihZn/Dirty7J HolyDirty7
TheMasihZn/toGiveTimeTo HolyToGiveTimeTo
TheMasihZn/IntellijCommunityAndroidCentral HolyApkIntellij}"
